# Copy to apps/web/.env.local for Vite
VITE_API_BASE_URL=http://localhost:4100

# Copy to apps/api/.env for the API
PORT=4100
JWT_SECRET=replace-with-a-strong-local-secret-at-least-32-chars
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORE_API_BASE_URL=http://localhost:8000

# Cloud OpenAI (optional if using local LLM below)
# OPENAI_API_KEY=

# Local OpenAI-compatible LLM (e.g. Ollama — backend calls this, not the browser)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3:latest
